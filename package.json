{
  "name": "@iooe/ranobelib-sdk",
  "version": "0.1.0",
  "description": "Production-oriented TypeScript SDK for public RanobeLib/lib.social metadata and chapter content.",
  "type": "module",
  "license": "MIT",
  "author": "iooe",
  "engines": {
    "node": ">=20.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ranobelib-sync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test ./test/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "ranobelib",
    "lib.social",
    "ranobe",
    "light-novel",
    "web-novel",
    "typescript",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iooe/ranobelib-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/iooe/ranobelib-node-sdk/issues"
  },
  "homepage": "https://github.com/iooe/ranobelib-node-sdk#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
